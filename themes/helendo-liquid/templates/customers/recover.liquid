<div class="hl-crumbband">
  <div class="hl-container hl-crumbband-inner">
    <h1 class="hl-crumbband-title">Reset password</h1>
    <nav class="hl-crumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span class="hl-current">Reset password</span></nav>
  </div>
</div>
<section class="hl-section hl-auth">
  <div class="hl-container">
    <div class="hl-auth-card">
      <h2 class="hl-title hl-title-sm">Reset your password</h2>
      <p class="hl-auth-sub">Enter your email and we will send you a link to set a new password.</p>
      <form data-account-form="recover" data-success="If an account exists for that email, a reset link is on its way.">
        <label class="hl-field"><span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <p class="hl-form-msg" data-form-msg hidden></p>
        <button type="submit" class="hl-btn hl-btn-block">Send reset link</button>
      </form>
      <div class="hl-auth-links">
        <a href="{{ routes.account_url }}/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>
