<div class="hl-crumbband">
  <div class="hl-container hl-crumbband-inner">
    <h1 class="hl-crumbband-title">New password</h1>
    <nav class="hl-crumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span class="hl-current">New password</span></nav>
  </div>
</div>
<section class="hl-section hl-auth">
  <div class="hl-container">
    <div class="hl-auth-card">
      <h2 class="hl-title hl-title-sm">Choose a new password</h2>
      {%- if reset.email != blank -%}
      <p class="hl-auth-sub">Setting a new password for {{ reset.email }}.</p>
      {%- endif -%}
      <form data-account-form="reset" data-success="Your password has been updated. You can now sign in.">
        <input type="hidden" name="token" value="{{ reset.token }}">
        <label class="hl-field"><span>New password</span>
          <input type="password" name="password" autocomplete="new-password" required>
        </label>
        <label class="hl-field"><span>Confirm new password</span>
          <input type="password" name="confirm" autocomplete="new-password" required>
        </label>
        <p class="hl-field-hint">At least 8 characters with an uppercase letter, a lowercase letter, a number and a special character.</p>
        <p class="hl-form-msg" data-form-msg hidden></p>
        <button type="submit" class="hl-btn hl-btn-block">Update password</button>
      </form>
      <div class="hl-auth-links">
        <a href="{{ routes.account_url }}/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>
