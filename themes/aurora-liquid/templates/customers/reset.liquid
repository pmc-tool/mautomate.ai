<nav class="au-crumbs"><div class="au-container">
  <a href="{{ routes.root_url }}">Home</a><span class="au-crumb-sep">/</span><span class="au-crumb-current">New password</span>
</div></nav>

<section class="au-section au-auth">
  <div class="au-container">
    <div class="au-auth-card au-card-flat">
      <span class="au-eyebrow">Account help</span>
      <h1 class="au-auth-title">Choose a new password</h1>
      {%- if reset.email != blank -%}
      <p class="au-auth-sub">Setting a new password for {{ reset.email }}.</p>
      {%- endif -%}
      <form data-account-form="reset" data-success="Your password has been updated. You can now sign in.">
        <input type="hidden" name="token" value="{{ reset.token }}">
        <label class="au-field"><span>New password</span>
          <input type="password" name="password" autocomplete="new-password" required>
        </label>
        <label class="au-field"><span>Confirm new password</span>
          <input type="password" name="confirm" autocomplete="new-password" required>
        </label>
        <p class="au-field-hint">At least 8 characters with an uppercase letter, a lowercase letter, a number and a special character.</p>
        <p class="au-form-msg" data-form-msg hidden></p>
        <button type="submit" class="au-btn au-btn-block">Update password</button>
      </form>
      <div class="au-auth-links">
        <a href="{{ routes.account_url }}/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>
