<nav class="au-crumbs"><div class="au-container">
  <a href="{{ routes.root_url }}">Home</a><span class="au-crumb-sep">/</span><span class="au-crumb-current">Sign in</span>
</div></nav>

<section class="au-section au-auth">
  <div class="au-container">
    <div class="au-auth-card au-card-flat">
      <span class="au-eyebrow">Welcome back</span>
      <h1 class="au-auth-title">Sign in</h1>
      <p class="au-auth-sub">Sign in to see your orders and manage your account.</p>
      <form data-account-form="login" data-redirect="{{ routes.account_url }}">
        <label class="au-field"><span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <label class="au-field"><span>Password</span>
          <input type="password" name="password" autocomplete="current-password" required>
        </label>
        <p class="au-form-msg" data-form-msg hidden></p>
        <button type="submit" class="au-btn au-btn-block">Sign in</button>
      </form>
      <div class="au-auth-links">
        <a href="{{ routes.root_url }}/recover">Forgot your password?</a>
        <span>New here? <a href="{{ routes.account_url }}/register">Create an account</a></span>
      </div>
    </div>
  </div>
</section>
