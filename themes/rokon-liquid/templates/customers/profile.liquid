<section class="rk-crumbband">
  <div class="rk-container">
    <h1 class="rk-crumb-title">Profile</h1>
    <ul class="rk-crumb-menu">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><a href="{{ routes.account_url }}">My account</a></li>
      <li><span class="rk-crumb-active">Profile</span></li>
    </ul>
  </div>
</section>
<section class="rk-section rk-account">
  <div class="rk-container">
    <div class="rk-acct-grid">
      {% render 'account-nav', routes: routes, customer: customer, active: 'profile' %}
      <div class="rk-acct-main">
        <form class="rk-profile-form" data-account-form="profile" data-success="Profile updated.">
          <div class="rk-field-row">
            <label class="rk-field"><span>First name</span>
              <input type="text" name="first_name" value="{{ customer.first_name }}" required>
            </label>
            <label class="rk-field"><span>Last name</span>
              <input type="text" name="last_name" value="{{ customer.last_name }}" required>
            </label>
          </div>
          <label class="rk-field"><span>Phone</span>
            <input type="tel" name="phone" value="{{ customer.phone }}">
          </label>
          <label class="rk-field"><span>Email</span>
            <input type="email" value="{{ customer.email }}" disabled>
          </label>
          <p class="rk-field-hint">To change your password, sign out and use <a href="{{ routes.root_url }}/recover">Forgot your password</a> — we will email you a secure reset link.</p>
          <p class="rk-form-msg" data-form-msg hidden></p>
          <button type="submit" class="rk-btn">Save changes</button>
        </form>
      </div>
    </div>
  </div>
</section>
