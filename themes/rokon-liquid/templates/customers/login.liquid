<section class="rk-crumbband">
  <div class="rk-container">
    <h1 class="rk-crumb-title">Sign In</h1>
    <ul class="rk-crumb-menu">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><span class="rk-crumb-active">Sign in</span></li>
    </ul>
  </div>
</section>
<section class="rk-section rk-auth">
  <div class="rk-container">
    <div class="rk-auth-card">
      <h2 class="rk-auth-title">Welcome back</h2>
      <p class="rk-auth-sub">Sign in to see your orders and manage your account.</p>
      <form data-account-form="login" data-redirect="{{ routes.account_url }}">
        <label class="rk-field"><span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <label class="rk-field"><span>Password</span>
          <input type="password" name="password" autocomplete="current-password" required>
        </label>
        <p class="rk-form-msg" data-form-msg hidden></p>
        <button type="submit" class="rk-btn rk-btn-block">Sign in</button>
      </form>
      <div class="rk-auth-links">
        <a href="{{ routes.root_url }}/recover">Forgot your password?</a>
        <span>New here? <a href="{{ routes.account_url }}/register">Create an account</a></span>
      </div>
    </div>
  </div>
</section>
