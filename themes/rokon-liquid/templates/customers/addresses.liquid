<section class="rk-crumbband">
  <div class="rk-container">
    <h1 class="rk-crumb-title">Addresses</h1>
    <ul class="rk-crumb-menu">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><a href="{{ routes.account_url }}">My account</a></li>
      <li><span class="rk-crumb-active">Addresses</span></li>
    </ul>
  </div>
</section>
<section class="rk-section rk-account">
  <div class="rk-container">
    <div class="rk-acct-grid">
      {% render 'account-nav', routes: routes, customer: customer, active: 'addresses' %}
      <div class="rk-acct-main">
        <div class="rk-acct-toolbar">
          <button type="button" class="rk-btn" data-address-new>Add address</button>
        </div>

        {%- if customer.addresses and customer.addresses.size > 0 -%}
        <div class="rk-addr-grid">
          {%- for address in customer.addresses -%}
          <div class="rk-addr-card">
            <p class="rk-addr-name">{{ address.first_name }} {{ address.last_name }}
              {%- if address.is_default_shipping %} <span class="rk-badge">Default shipping</span>{% endif -%}
              {%- if address.is_default_billing %} <span class="rk-badge">Default billing</span>{% endif -%}
            </p>
            <p class="rk-addr-lines">{{ address.address_1 }}{% if address.address_2 != blank %}, {{ address.address_2 }}{% endif %}<br>
            {{ address.city }}{% if address.province != blank %}, {{ address.province }}{% endif %} {{ address.postal_code }}<br>
            {{ address.country_code }}{% if address.phone != blank %} &middot; {{ address.phone }}{% endif %}</p>
            <div class="rk-addr-actions">
              <button type="button" class="rk-link rk-link-ink" data-address-edit
                data-a-address_id="{{ address.id }}"
                data-a-first_name="{{ address.first_name }}"
                data-a-last_name="{{ address.last_name }}"
                data-a-company="{{ address.company }}"
                data-a-address_1="{{ address.address_1 }}"
                data-a-address_2="{{ address.address_2 }}"
                data-a-city="{{ address.city }}"
                data-a-postal_code="{{ address.postal_code }}"
                data-a-province="{{ address.province }}"
                data-a-country_code="{{ address.country_code | downcase }}"
                data-a-phone="{{ address.phone }}">Edit</button>
              <button type="button" class="rk-link rk-link-danger" data-address-delete="{{ address.id }}">Delete</button>
            </div>
          </div>
          {%- endfor -%}
        </div>
        {%- else -%}
        <div class="rk-acct-empty"><p>No saved addresses yet.</p></div>
        {%- endif -%}

        <form class="rk-addr-form" data-account-form="address" data-success="Address saved." hidden>
          <h2 class="rk-acct-h2">Address details</h2>
          <input type="hidden" name="address_id" value="">
          <div class="rk-field-row">
            <label class="rk-field"><span>First name</span><input type="text" name="first_name" required></label>
            <label class="rk-field"><span>Last name</span><input type="text" name="last_name" required></label>
          </div>
          <label class="rk-field"><span>Company <em>(optional)</em></span><input type="text" name="company"></label>
          <label class="rk-field"><span>Address</span><input type="text" name="address_1" required></label>
          <label class="rk-field"><span>Apartment, suite, etc. <em>(optional)</em></span><input type="text" name="address_2"></label>
          <div class="rk-field-row">
            <label class="rk-field"><span>City</span><input type="text" name="city" required></label>
            <label class="rk-field"><span>Postal code</span><input type="text" name="postal_code" required></label>
          </div>
          <div class="rk-field-row">
            <label class="rk-field"><span>Province / state <em>(optional)</em></span><input type="text" name="province"></label>
            <label class="rk-field"><span>Country</span>
              <select name="country_code" required>
                {%- for country in countries -%}
                <option value="{{ country.code }}">{{ country.name }}</option>
                {%- endfor -%}
              </select>
            </label>
          </div>
          <label class="rk-field"><span>Phone <em>(optional)</em></span><input type="tel" name="phone"></label>
          <div class="rk-field-row">
            <label class="rk-check"><input type="checkbox" name="default_shipping"><span>Default shipping address</span></label>
            <label class="rk-check"><input type="checkbox" name="default_billing"><span>Default billing address</span></label>
          </div>
          <p class="rk-form-msg" data-form-msg hidden></p>
          <button type="submit" class="rk-btn">Save address</button>
        </form>
      </div>
    </div>
  </div>
</section>
