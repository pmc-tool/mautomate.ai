<div class="bz-pageband">
  <div class="bz-container">
    <h1 class="bz-pageband-title">Reset Password</h1>
    <nav class="bz-pageband-crumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span class="bz-current">Reset password</span></nav>
  </div>
</div>
<section class="bz-section bz-auth">
  <div class="bz-container">
    <div class="bz-auth-card">
      <h2 class="bz-auth-title">Reset your password</h2>
      <p class="bz-auth-sub">Enter your email and we will send you a link to set a new password.</p>
      <form data-account-form="recover" data-success="If an account exists for that email, a reset link is on its way.">
        <label class="bz-field"><span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <p class="bz-form-msg" data-form-msg hidden></p>
        <button type="submit" class="bz-btn bz-btn-block">Send reset link</button>
      </form>
      <div class="bz-auth-links">
        <a href="{{ routes.account_url }}/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>
