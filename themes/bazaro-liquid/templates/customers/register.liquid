<div class="bz-pageband">
  <div class="bz-container">
    <h1 class="bz-pageband-title">Create Account</h1>
    <nav class="bz-pageband-crumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span class="bz-current">Create account</span></nav>
  </div>
</div>
<section class="bz-section bz-auth">
  <div class="bz-container">
    <div class="bz-auth-card bz-auth-wide">
      <h2 class="bz-auth-title">Join Bazaro</h2>
      <p class="bz-auth-sub">Track orders, save your details and check out faster.</p>
      <form data-account-form="register" data-redirect="{{ routes.account_url }}">
        <div class="bz-field-row">
          <label class="bz-field"><span>First name</span>
            <input type="text" name="first_name" autocomplete="given-name" required>
          </label>
          <label class="bz-field"><span>Last name</span>
            <input type="text" name="last_name" autocomplete="family-name" required>
          </label>
        </div>
        <label class="bz-field"><span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <label class="bz-field"><span>Phone <em>(optional)</em></span>
          <input type="tel" name="phone" autocomplete="tel">
        </label>
        <div class="bz-field-row">
          <label class="bz-field"><span>Password</span>
            <input type="password" name="password" autocomplete="new-password" required>
          </label>
          <label class="bz-field"><span>Confirm password</span>
            <input type="password" name="confirm_password" autocomplete="new-password" required>
          </label>
        </div>
        <p class="bz-field-hint">At least 8 characters with an uppercase letter, a lowercase letter, a number and a special character.</p>
        <label class="bz-check">
          <input type="checkbox" name="terms_accepted">
          <span>I agree to the <a href="{{ routes.root_url }}/terms-of-use" target="_blank">Terms of Use</a> and <a href="{{ routes.root_url }}/privacy-policy" target="_blank">Privacy Policy</a>.</span>
        </label>
        <p class="bz-form-msg" data-form-msg hidden></p>
        <button type="submit" class="bz-btn bz-btn-block">Create account</button>
      </form>
      <div class="bz-auth-links">
        <span>Already have an account? <a href="{{ routes.account_url }}/login">Sign in</a></span>
      </div>
    </div>
  </div>
</section>
