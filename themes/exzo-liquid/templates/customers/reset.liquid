<nav class="ex-crumbs"><div class="ex-container">
  <a href="{{ routes.root_url }}">Home</a><span>/</span><span class="ex-current">New password</span>
</div></nav>
<section class="ex-section ex-auth">
  <div class="ex-container">
    <div class="ex-auth-card">
      <h1 class="ex-title ex-title-sm">Choose a new password</h1>
      <span class="ex-underline ex-underline-left"><span></span></span>
      {%- if reset.email != blank -%}
      <p class="ex-auth-sub">Setting a new password for {{ reset.email }}.</p>
      {%- endif -%}
      <form data-account-form="reset" data-success="Your password has been updated. You can now sign in.">
        <input type="hidden" name="token" value="{{ reset.token }}">
        <label class="ex-field"><span>New password</span>
          <input type="password" name="password" autocomplete="new-password" required>
        </label>
        <label class="ex-field"><span>Confirm new password</span>
          <input type="password" name="confirm" autocomplete="new-password" required>
        </label>
        <p class="ex-field-hint">At least 8 characters with an uppercase letter, a lowercase letter, a number and a special character.</p>
        <p class="ex-form-msg" data-form-msg hidden></p>
        <button type="submit" class="ex-btn ex-btn-block">Update password</button>
      </form>
      <div class="ex-auth-links">
        <a href="{{ routes.account_url }}/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>
