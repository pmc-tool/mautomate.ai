<nav class="ex-crumbs"><div class="ex-container">
  <a href="{{ routes.root_url }}">Home</a><span>/</span><span class="ex-current">Reset password</span>
</div></nav>
<section class="ex-section ex-auth">
  <div class="ex-container">
    <div class="ex-auth-card">
      <h1 class="ex-title ex-title-sm">Reset your password</h1>
      <span class="ex-underline ex-underline-left"><span></span></span>
      <p class="ex-auth-sub">Enter your email and we will send you a link to set a new password.</p>
      <form data-account-form="recover" data-success="If an account exists for that email, a reset link is on its way.">
        <label class="ex-field"><span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <p class="ex-form-msg" data-form-msg hidden></p>
        <button type="submit" class="ex-btn ex-btn-block">Send reset link</button>
      </form>
      <div class="ex-auth-links">
        <a href="{{ routes.account_url }}/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>
