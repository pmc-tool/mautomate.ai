<div class="cg-pagehead">
  <div class="cg-container">
    <h1 class="cg-pagehead-title">Create account</h1>
    <nav class="cg-pagehead-crumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span class="cg-current">Create account</span></nav>
  </div>
</div>
<section class="cg-section cg-auth">
  <div class="cg-container">
    <div class="cg-auth-card cg-auth-wide">
      <span class="cg-eyebrow">Join us</span>
      <h2 class="cg-auth-title">Create your account</h2>
      <p class="cg-auth-sub">Track orders, save your details and check out faster.</p>
      <form data-account-form="register" data-redirect="{{ routes.account_url }}">
        <div class="cg-field-row">
          <label class="cg-field"><span>First name</span>
            <input type="text" name="first_name" autocomplete="given-name" required>
          </label>
          <label class="cg-field"><span>Last name</span>
            <input type="text" name="last_name" autocomplete="family-name" required>
          </label>
        </div>
        <label class="cg-field"><span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <label class="cg-field"><span>Phone <em>(optional)</em></span>
          <input type="tel" name="phone" autocomplete="tel">
        </label>
        <div class="cg-field-row">
          <label class="cg-field"><span>Password</span>
            <input type="password" name="password" autocomplete="new-password" required>
          </label>
          <label class="cg-field"><span>Confirm password</span>
            <input type="password" name="confirm_password" autocomplete="new-password" required>
          </label>
        </div>
        <p class="cg-field-hint">At least 8 characters with an uppercase letter, a lowercase letter, a number and a special character.</p>
        <label class="cg-check">
          <input type="checkbox" name="terms_accepted">
          <span>I agree to the <a href="{{ routes.root_url }}/terms-of-use" target="_blank">Terms of Use</a> and <a href="{{ routes.root_url }}/privacy-policy" target="_blank">Privacy Policy</a>.</span>
        </label>
        <p class="cg-form-msg" data-form-msg hidden></p>
        <button type="submit" class="cg-btn cg-btn-solid cg-btn-block">Create account</button>
      </form>
      <div class="cg-auth-links">
        <span>Already have an account? <a href="{{ routes.account_url }}/login">Sign in</a></span>
      </div>
    </div>
  </div>
</section>
