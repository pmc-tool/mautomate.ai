<div class="cg-pagehead">
  <div class="cg-container">
    <h1 class="cg-pagehead-title">Reset password</h1>
    <nav class="cg-pagehead-crumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span class="cg-current">Reset password</span></nav>
  </div>
</div>
<section class="cg-section cg-auth">
  <div class="cg-container">
    <div class="cg-auth-card">
      <span class="cg-eyebrow">Account help</span>
      <h2 class="cg-auth-title">Reset your password</h2>
      <p class="cg-auth-sub">Enter your email and we will send you a link to set a new password.</p>
      <form data-account-form="recover" data-success="If an account exists for that email, a reset link is on its way.">
        <label class="cg-field"><span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <p class="cg-form-msg" data-form-msg hidden></p>
        <button type="submit" class="cg-btn cg-btn-solid cg-btn-block">Send reset link</button>
      </form>
      <div class="cg-auth-links">
        <a href="{{ routes.account_url }}/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>
