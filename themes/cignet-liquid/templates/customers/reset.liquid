<div class="cg-pagehead">
  <div class="cg-container">
    <h1 class="cg-pagehead-title">New password</h1>
    <nav class="cg-pagehead-crumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span class="cg-current">New password</span></nav>
  </div>
</div>
<section class="cg-section cg-auth">
  <div class="cg-container">
    <div class="cg-auth-card">
      <span class="cg-eyebrow">Account help</span>
      <h2 class="cg-auth-title">Choose a new password</h2>
      {%- if reset.email != blank -%}
      <p class="cg-auth-sub">Setting a new password for {{ reset.email }}.</p>
      {%- endif -%}
      <form data-account-form="reset" data-success="Your password has been updated. You can now sign in.">
        <input type="hidden" name="token" value="{{ reset.token }}">
        <label class="cg-field"><span>New password</span>
          <input type="password" name="password" autocomplete="new-password" required>
        </label>
        <label class="cg-field"><span>Confirm new password</span>
          <input type="password" name="confirm" autocomplete="new-password" required>
        </label>
        <p class="cg-field-hint">At least 8 characters with an uppercase letter, a lowercase letter, a number and a special character.</p>
        <p class="cg-form-msg" data-form-msg hidden></p>
        <button type="submit" class="cg-btn cg-btn-solid cg-btn-block">Update password</button>
      </form>
      <div class="cg-auth-links">
        <a href="{{ routes.account_url }}/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>
