<div class="cg-pagehead">
  <div class="cg-container">
    <h1 class="cg-pagehead-title">Orders</h1>
    <nav class="cg-pagehead-crumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.account_url }}">My account</a><span>/</span><span class="cg-current">Orders</span></nav>
  </div>
</div>
<section class="cg-section cg-account">
  <div class="cg-container">
    <div class="cg-acct-grid">
      {% render 'account-nav', routes: routes, customer: customer, active: 'orders' %}
      <div class="cg-acct-main">
        {%- if orders and orders.size > 0 -%}
        <div class="cg-orders-table">
          <div class="cg-orders-row cg-orders-head"><span>Order</span><span>Date</span><span>Status</span><span>Total</span><span></span></div>
          {%- for order in orders -%}
          <div class="cg-orders-row">
            <span class="cg-order-name">{{ order.name }}</span>
            <span>{{ order.created_at | date: "%b %d, %Y" }}</span>
            <span><span class="cg-badge">{{ order.fulfillment_status | replace: "_", " " | capitalize }}</span></span>
            <span>{{ order.total | money }}</span>
            <span><a class="cg-link" href="{{ routes.account_url }}/orders/details/{{ order.id }}">View</a></span>
          </div>
          {%- endfor -%}
        </div>
        {%- else -%}
        <div class="cg-acct-empty"><p>You have not placed any orders yet.</p><a class="cg-btn cg-btn-solid" href="{{ routes.collections_url }}">Start shopping</a></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
