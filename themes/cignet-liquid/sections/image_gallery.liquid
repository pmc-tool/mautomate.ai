{%- assign s = section.settings -%}
{%- assign images = s.images -%}
{%- if images and images.size > 0 -%}
<section class="cg-section cg-gallery{% if section.in_column %} cg-in-column{% endif %}">
  <div class="cg-container">
    {%- if s.title != blank -%}<div class="cg-shead cg-shead-center"><h2 class="cg-title" data-el="heading">{{ s.title }}</h2></div>{%- endif -%}
    <div class="cg-gallery-grid" data-el="grid">
      {%- for item in images -%}
        {%- assign src = item.image | default: item -%}
        {%- if src != blank -%}
        <figure class="cg-gallery-cell" data-el-item="items:{{ forloop.index0 }}" data-el="item"><img src="{{ src }}" alt="{{ item.alt | default: 'Gallery image' }}">{% if item.caption != blank %}<figcaption data-el="caption">{{ item.caption }}</figcaption>{% endif %}</figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
