<nav class="kt-crumbs"><div class="kt-container">
  <a href="{{ routes.root_url }}">Home</a><span>/</span><span class="kt-current">New password</span>
</div></nav>
<section class="kt-section kt-auth">
  <div class="kt-container">
    <div class="kt-auth-card">
      <span class="kt-eyebrow">Account</span>
      <h1 class="kt-title kt-title-sm">Choose a new password</h1>
      {%- if reset.email != blank -%}
      <p class="kt-auth-sub">Setting a new password for {{ reset.email }}.</p>
      {%- endif -%}
      <form data-account-form="reset" data-success="Your password has been updated. You can now sign in.">
        <input type="hidden" name="token" value="{{ reset.token }}">
        <label class="kt-field"><span>New password</span>
          <input type="password" name="password" autocomplete="new-password" required>
        </label>
        <label class="kt-field"><span>Confirm new password</span>
          <input type="password" name="confirm" autocomplete="new-password" required>
        </label>
        <p class="kt-field-hint">At least 8 characters with an uppercase letter, a lowercase letter, a number and a special character.</p>
        <p class="kt-form-msg" data-form-msg hidden></p>
        <button type="submit" class="kt-btn kt-btn-block">Update password</button>
      </form>
      <div class="kt-auth-links">
        <a href="{{ routes.account_url }}/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>
