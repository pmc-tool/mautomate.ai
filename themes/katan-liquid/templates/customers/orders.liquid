<nav class="kt-crumbs"><div class="kt-container">
  <a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.account_url }}">My account</a><span>/</span><span class="kt-current">Orders</span>
</div></nav>
<section class="kt-section kt-account">
  <div class="kt-container">
    <div class="kt-shead"><span class="kt-eyebrow">My account</span><h1 class="kt-title">Orders</h1></div>
    <div class="kt-acct-grid">
      {% render 'account-nav', routes: routes, customer: customer, active: 'orders' %}
      <div class="kt-acct-main">
        {%- if orders and orders.size > 0 -%}
        <div class="kt-orders-table">
          <div class="kt-orders-row kt-orders-head"><span>Order</span><span>Date</span><span>Status</span><span>Total</span><span></span></div>
          {%- for order in orders -%}
          <div class="kt-orders-row">
            <span class="kt-order-name">{{ order.name }}</span>
            <span>{{ order.created_at | date: "%b %d, %Y" }}</span>
            <span><span class="kt-badge">{{ order.fulfillment_status | replace: "_", " " | capitalize }}</span></span>
            <span>{{ order.total | money }}</span>
            <span><a class="kt-link" href="{{ routes.account_url }}/orders/details/{{ order.id }}">View</a></span>
          </div>
          {%- endfor -%}
        </div>
        {%- else -%}
        <div class="kt-acct-empty"><p>You have not placed any orders yet.</p><a class="kt-btn" href="{{ routes.collections_url }}">Start shopping</a></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
