<div class="sf-pagehead">
  <div class="sf-container">
    <h1 class="sf-pagehead-title">New Password</h1>
    <nav class="sf-pagehead-crumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span class="sf-current">New password</span></nav>
  </div>
</div>
<section class="sf-section sf-auth">
  <div class="sf-container">
    <div class="sf-auth-card">
      <span class="sf-auth-icon"><i class="fas fa-key"></i></span>
      <h2 class="sf-auth-title">Choose a new password</h2>
      {%- if reset.email != blank -%}
      <p class="sf-auth-sub">Setting a new password for {{ reset.email }}.</p>
      {%- endif -%}
      <form data-account-form="reset" data-success="Your password has been updated. You can now sign in.">
        <input type="hidden" name="token" value="{{ reset.token }}">
        <label class="sf-field"><span>New password</span>
          <input type="password" name="password" autocomplete="new-password" required>
        </label>
        <label class="sf-field"><span>Confirm new password</span>
          <input type="password" name="confirm" autocomplete="new-password" required>
        </label>
        <p class="sf-field-hint">At least 8 characters with an uppercase letter, a lowercase letter, a number and a special character.</p>
        <p class="sf-form-msg" data-form-msg hidden></p>
        <button type="submit" class="sf-btn sf-btn-primary sf-btn-block">Update Password <i class="fas fa-arrow-right"></i></button>
      </form>
      <div class="sf-auth-links">
        <a href="{{ routes.account_url }}/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>
