{%- assign s = section.settings -%}
{%- assign brands = s.brands -%}
<section class="sf-section sf-brands{% if section.in_column %} sf-in-column{% endif %}">
  <div class="sf-container">
    {%- if s.title != blank -%}<div class="sf-shead sf-shead-center"><h2 class="sf-title sf-title-sm" data-el="title">{{ s.title }}</h2></div>{%- endif -%}
    {%- if brands and brands.size > 0 -%}
    <div class="sf-brand-row">
      {%- for brand in brands -%}<a class="sf-brand" href="{{ brand.href | default: '#' }}" data-el-item="brands:{{ forloop.index0 }}" data-el="logo">{% if brand.image %}<img src="{{ brand.image }}" alt="Brand">{% endif %}</a>{%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>
