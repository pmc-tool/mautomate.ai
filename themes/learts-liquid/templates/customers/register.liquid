<nav class="lz-crumbs"><div class="lz-container">
  <a href="{{ routes.root_url }}">Home</a><span>/</span><span class="lz-current">Create account</span>
</div></nav>
<section class="lz-section lz-auth">
  <div class="lz-container">
    <div class="lz-auth-card lz-auth-wide">
      <h1 class="lz-title lz-title-sm">Create account</h1>
      <p class="lz-auth-sub">Track orders, save your details and check out faster.</p>
      <form data-account-form="register" data-redirect="{{ routes.account_url }}">
        <div class="lz-field-row">
          <label class="lz-field"><span>First name</span>
            <input type="text" name="first_name" autocomplete="given-name" required>
          </label>
          <label class="lz-field"><span>Last name</span>
            <input type="text" name="last_name" autocomplete="family-name" required>
          </label>
        </div>
        <label class="lz-field"><span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <label class="lz-field"><span>Phone <em>(optional)</em></span>
          <input type="tel" name="phone" autocomplete="tel">
        </label>
        <div class="lz-field-row">
          <label class="lz-field"><span>Password</span>
            <input type="password" name="password" autocomplete="new-password" required>
          </label>
          <label class="lz-field"><span>Confirm password</span>
            <input type="password" name="confirm_password" autocomplete="new-password" required>
          </label>
        </div>
        <p class="lz-field-hint">At least 8 characters with an uppercase letter, a lowercase letter, a number and a special character.</p>
        <label class="lz-check">
          <input type="checkbox" name="terms_accepted">
          <span>I agree to the <a href="{{ routes.root_url }}/terms-of-use" target="_blank">Terms of Use</a> and <a href="{{ routes.root_url }}/privacy-policy" target="_blank">Privacy Policy</a>.</span>
        </label>
        <p class="lz-form-msg" data-form-msg hidden></p>
        <button type="submit" class="lz-btn lz-btn-block">Create account</button>
      </form>
      <div class="lz-auth-links">
        <span>Already have an account? <a href="{{ routes.account_url }}/login">Sign in</a></span>
      </div>
    </div>
  </div>
</section>
