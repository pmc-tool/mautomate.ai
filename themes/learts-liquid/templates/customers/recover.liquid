<nav class="lz-crumbs"><div class="lz-container">
  <a href="{{ routes.root_url }}">Home</a><span>/</span><span class="lz-current">Reset password</span>
</div></nav>
<section class="lz-section lz-auth">
  <div class="lz-container">
    <div class="lz-auth-card">
      <h1 class="lz-title lz-title-sm">Reset your password</h1>
      <p class="lz-auth-sub">Enter your email and we will send you a link to set a new password.</p>
      <form data-account-form="recover" data-success="If an account exists for that email, a reset link is on its way.">
        <label class="lz-field"><span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <p class="lz-form-msg" data-form-msg hidden></p>
        <button type="submit" class="lz-btn lz-btn-block">Send reset link</button>
      </form>
      <div class="lz-auth-links">
        <a href="{{ routes.account_url }}/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>
