<nav class="lz-crumbs"><div class="lz-container">
  <a href="{{ routes.root_url }}">Home</a><span>/</span><span class="lz-current">Sign in</span>
</div></nav>
<section class="lz-section lz-auth">
  <div class="lz-container">
    <div class="lz-auth-card">
      <h1 class="lz-title lz-title-sm">Sign in</h1>
      <p class="lz-auth-sub">Welcome back. Sign in to see your orders and manage your account.</p>
      <form data-account-form="login" data-redirect="{{ routes.account_url }}">
        <label class="lz-field"><span>Email</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <label class="lz-field"><span>Password</span>
          <input type="password" name="password" autocomplete="current-password" required>
        </label>
        <p class="lz-form-msg" data-form-msg hidden></p>
        <button type="submit" class="lz-btn lz-btn-block">Sign in</button>
      </form>
      <div class="lz-auth-links">
        <a href="{{ routes.root_url }}/recover">Forgot your password?</a>
        <span>New here? <a href="{{ routes.account_url }}/register">Create an account</a></span>
      </div>
    </div>
  </div>
</section>
